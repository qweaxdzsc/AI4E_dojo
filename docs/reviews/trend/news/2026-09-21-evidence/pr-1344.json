    "following_url": "https://api.github.com/users/cathalobrien/following{/other_user}",
    "gists_url": "https://api.github.com/users/cathalobrien/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/cathalobrien/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/cathalobrien/subscriptions",
    "organizations_url": "https://api.github.com/users/cathalobrien/orgs",
    "repos_url": "https://api.github.com/users/cathalobrien/repos",
    "events_url": "https://api.github.com/users/cathalobrien/events{/privacy}",
