  "kriging_formula": {
    "variant": "Ordinary unknown constant or universal unknown linear trend; fixed observation noise; squared-exponential covariance; plug-in profile maximum likelihood.",
    "training_matrix": "C = K + diag(observation_noise_variance) + numerical_jitter * I",
    "mean": "F_query beta + K_query_train alpha; beta is GLS, alpha solves C alpha = y - F beta",
    "variance": "diag(K_query_query) - diag(K_query_train C^-1 K_train_query) + diag(R (F^T C^-1 F)^-1 R^T), R = F_query - K_query_train C^-1 F",
    "independent_reference": "Augmented saddle-point solve [[C,F],[F^T,0]]; product uses Cholesky/GLS. No imported SMT or sklearn zero-mean GP is claimed.",
    "bibliography": [
      {
        "authors": "Carl Edward Rasmussen and Christopher K. I. Williams",
        "title": "Gaussian Processes for Machine Learning",
        "year": 2006,
        "publisher": "MIT Press",
        "location": "Chapter 2, explicit basis functions",
        "url": "https://gaussianprocess.org/gpml/chapters/RW2.pdf",
        "use": "Mathematical background citation; no book text or code redistributed; no paper-level training claimed."
      }
    ],
    "objective": "0.5 * (logdet(C) + residual^T C^-1 residual + N*log(2*pi)); profile ML, not REML or integrated hyperparameter uncertainty.",
    "gradient": "For each log hyperparameter theta: 0.5*trace(C^-1*dC/dtheta) - 0.5*alpha.T*(dC/dtheta)*alpha. Squared-exponential dK/dlog(length_j)=K*distance_j^2/length_j^2; dK/dlog(variance)=K.",
    "gradient_implementations": "Product uses Cholesky solves; independent augmented GLS reference uses SciPy LU solves. Both supply analytic Jacobians to L-BFGS-B, without sharing computation code.",
    "numerical_diagnosis": "Original NumPy slogdet emitted floating-point warnings on three fixed positive definite covariance matrices, yet finite final logdet agreed with Cholesky within 3.3e-10. Replacement LU logdet avoids treating those warnings as proof of NaN; original failed optimization evidence remains retained."
  },
